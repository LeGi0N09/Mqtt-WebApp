@model IEnumerable<MQTTWebApp.Models.MqttPublishViewModel>

<!DOCTYPE html>
<html>
<head>
    <title>Published Messages</title>
</head>
<body>
    <div class="container mt-5">
        <h1 class="mb-4">Published Messages</h1>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Topic</th>
                    <th>Message</th>
                    <th>Publish DateTime</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var message in Model)
                {
                    <tr>
                        <td>@message.Topic</td>
                        <td>@message.Message</td>
                        <td>@message.PublishDateTime</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
